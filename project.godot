config_version=5

[application]
config/name="VELUM"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.4", "Forward Plus")

[display]
window/size/viewport_width=1280
window/size/viewport_height=800
window/size/min_width=960
window/size/min_height=600
window/stretch/mode="canvas_items"

[rendering]
streamline/reflex_mode=1
lights_and_shadows/directional_shadow/size=4096
lights_and_shadows/positional_shadow/atlas_size=4096
environment/volumetric_fog/volume_size=128
environment/volumetric_fog/volume_depth=128
renderer/rendering_method="forward_plus"
renderer/rendering_method.web="gl_compatibility"
rendering_device/driver.windows="d3d12"
textures/default_filters/use_nearest_mipmap_filter=false
textures/vram_compression/import_etc2_astc=true
environment/defaults/default_clear_color=Color(0.025,0.06,0.09,1)
